# Shopify Storefront API
# Required for snapshot checks (announcement, timer, flash banners)
# Obtain from: Shopify Admin > Apps > Headless > Storefronts > API credentials
SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_token_here

# Telegram Bot for Alerting
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional Monitoring Configuration
# Retry/Backoff settings for the Telegram client
TELEGRAM_RETRY_AFTER_MS=30000
